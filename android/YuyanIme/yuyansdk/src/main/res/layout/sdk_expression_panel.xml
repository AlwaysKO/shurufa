<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/expression_recommendation_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/expression_tab_bar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/expression_tab_recommended"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/expression_tab_recommended"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/expression_tab_templates"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/expression_tab_ai_synthesis"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/expression_tab_emoji"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/expression_tab_emoji_synthesis"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/expression_actions"
                android:layout_width="64dp"
                android:layout_height="26dp"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/expression_more"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/expression_settings"
                    android:padding="6dp"
                    android:src="@drawable/ic_menu_more_horiz" />

                <ImageButton
                    android:id="@+id/expression_close"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/expression_tool_hide_recommendations"
                    android:padding="6dp"
                    android:src="@drawable/ic_ai_sticker_close_target" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/expression_content"
            android:layout_width="match_parent"
            android:layout_height="116dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/expression_asset_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <com.yuyan.imemodule.expression.ui.EmojiCombinationPicker
                android:id="@+id/expression_emoji_picker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
            <TextView
                android:id="@+id/expression_empty_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/expression_no_related_templates"
                android:visibility="gone" />
            <TextView
                android:id="@+id/expression_preparing_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:textColor="#333333"
                android:gravity="center"
                android:padding="8dp"
                android:contentDescription="@string/expression_preparing_image"
                android:clickable="true"
                android:focusable="true"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
        </FrameLayout>
        <TextView
            android:id="@+id/expression_return_keyboard"
            android:tag="expression_return_keyboard"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/quick_settings_back_keyboard"
            android:textSize="14sp"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/expression_tool_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@android:color/transparent"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/expression_enable"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/ai_sticker_search"
            android:textColor="@android:color/black"
            android:textSize="12sp" />
    </LinearLayout>
</merge>
