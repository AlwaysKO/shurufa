<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/expression_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/expression_tab_recommended"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/selector_expression_tab_background"
            android:gravity="center"
            android:text="推荐"
            android:textColor="@color/selector_expression_tab_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/expression_tab_templates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/selector_expression_tab_background"
            android:gravity="center"
            android:text="AI合成"
            android:textColor="@color/selector_expression_tab_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/expression_tab_emoji"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/selector_expression_tab_background"
            android:gravity="center"
            android:text="Emoji合成"
            android:textColor="@color/selector_expression_tab_text"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/expression_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="AI斗图设置"
            android:padding="10dp"
            android:src="@drawable/ic_menu_more_horiz" />

        <ImageButton
            android:id="@+id/expression_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭AI斗图"
            android:padding="10dp"
            android:src="@drawable/ic_menu_close_thin" />

        <View
            android:id="@+id/expression_disabled_spacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/expression_enable"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:drawableStart="@drawable/ic_ai_sticker_toggle"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="AI斗图"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/expression_content"
        android:layout_width="match_parent"
        android:layout_height="116dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/expression_asset_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <com.yuyan.imemodule.expression.ui.EmojiCombinationPicker
            android:id="@+id/expression_emoji_picker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</merge>
