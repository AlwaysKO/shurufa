# 线上配置：复制为 .env.production，并替换数据库密码
APP_ENV=production
NODE_ENV=production
PORT=3000
API_BASE_URL=https://myapi.dog8ball.com
EXPRESSION_SEARCH_PROVIDER_URL=https://api.xcvts.cn/api/img/qqbqbss
MANAGE_BASE_URL=https://mymanage.dog8ball.com

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=ime
PGPASSWORD=请替换为线上数据库强密码
PGDATABASE=personal_ime

ANALYZE_CRON=*/10 * * * *
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# 网页认证必填：设置独立管理员账号、至少 16 字符唯一强密码；留空会拒绝启动。
# 不要使用本地开发密码或把下面的空值直接部署。
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# 实际网页源，而不是手机 API 域名（无末尾 /）。
DASHBOARD_ORIGIN=https://mymanage.dog8ball.com
