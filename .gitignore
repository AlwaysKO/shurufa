# 依赖与构建产物
node_modules/
dist/
build/
.gradle/
.kotlin/
*.log
*.tsbuildinfo

# 环境变量（含数据库密码，严禁提交）
.env
.env.*
!.env.*.example
!.env.example
.runtime/
assets/expression/contact-sheets/*.draft.png

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# Android 签名与本地配置
*.jks
keystore.properties
local.properties

# 安装包仅保留在本地，不提交 Git
*.apk
*.aab

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/

# Windows 命令重定向误生成文件
/NUL

