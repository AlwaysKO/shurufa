{
  "name": "shurufa-server",
  "version": "0.1.0",
  "private": true,
  "description": "私人输入法后端：采集、分析、补全模型、Dashboard API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "analyze": "tsx src/jobs/analyze.ts",
    "analyze:once": "tsx src/jobs/analyze.ts --once",
    "expression:crop": "tsx scripts/crop-expression-contact-sheets.ts",
    "expression:generate": "tsx scripts/generate-expression-assets.ts",
    "expression:prototype": "tsx scripts/render-expression-prototypes.ts",
    "test": "vitest run src",
    "test:watch": "vitest src"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "pinyin-pro": "^3.25.0",
    "sharp": "^0.35.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
