# 服务配置
PORT=3000
NODE_ENV=development

# PostgreSQL（WSL 本地）
PGHOST=localhost
PGPORT=5432
PGUSER=ime
PGPASSWORD=CHANGE_ME
PGDATABASE=personal_ime

# 定时分析任务（cron 表达式，默认每 10 分钟）
ANALYZE_CRON=*/10 * * * *

# 普通词斗图联网搜索源；留空可关闭，结果缓存到 .runtime/expression-assets/search-cache。
EXPRESSION_SEARCH_PROVIDER_URL=https://api.xcvts.cn/api/img/qqbqbss

# 网页后台：开发环境默认 admin / adminhaha，不写入前端。
# 生产必须设置 NODE_ENV=production、独立账号和至少 16 字符唯一密码，否则拒绝启动。
# DASHBOARD_USERNAME=owner
# DASHBOARD_PASSWORD=replace-with-a-unique-long-random-password
# 实际网页管理后台的准确源（协议+域名+可选端口，无末尾 /），不是必然等于手机 API 域名。
# 反代部署建议显式设置；如网页在 mymanage.dog8ball.com、API 在其他域名，则填网页域名。
# DASHBOARD_ORIGIN=https://mymanage.dog8ball.com

# DeepSeek 关系画像与 AI 回复；密钥只配置在服务端，留空时自动回退零 Token 候选。
# DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=12000
RELATIONSHIP_AI_MIN_MESSAGES=20
RELATIONSHIP_AI_MAX_MESSAGES=200
RELATIONSHIP_AI_DAILY_REPLY_LIMIT=50
RELATIONSHIP_AI_MONTHLY_TOKEN_LIMIT=1000000
