# 本地开发配置：复制为 .env.local 后按需修改
APP_ENV=local
NODE_ENV=development
PORT=3000
API_BASE_URL=http://127.0.0.1:3000
EXPRESSION_SEARCH_PROVIDER_URL=https://api.xcvts.cn/api/img/qqbqbss
MANAGE_BASE_URL=http://127.0.0.1:5175

# 仅限已通过 USB 调试授权的个人开发机：APK 覆盖安装后自动恢复聊天采集无障碍服务。
AUTO_ENABLE_CHAT_ACCESSIBILITY=false
DASHBOARD_HOST=0.0.0.0

# WSL 使用 Windows ADB 走 USB 数据线时可配置；留空则自动查找 ADB。
# ADB=/mnt/c/Users/<Windows用户名>/Android/platform-tools/adb.exe
# Platform Tools 37 在部分国产手机上需要旧 USB 后端。
ADB_USB_LEGACY=1
ADB_RELAY_PORT=3001

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=ime
PGPASSWORD=CHANGE_ME
PGDATABASE=personal_ime

ANALYZE_CRON=*/10 * * * *

# 本地开发网页登录默认 admin / adminhaha；仅 development 可使用默认值。
# 可按需覆盖，生产必须使用独立强密码。
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=adminhaha
# 留空按请求源校验，兼容 localhost 与 127.0.0.1；设置时必须等于实际浏览器页面源。
# DASHBOARD_ORIGIN=http://localhost:5175
