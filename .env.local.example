# 本地开发配置：复制为 .env.local 后按需修改
APP_ENV=local
NODE_ENV=development
PORT=3000
API_BASE_URL=http://127.0.0.1:3000
MANAGE_BASE_URL=http://127.0.0.1:5175
DASHBOARD_HOST=0.0.0.0

# WSL 使用 Windows ADB 走 USB 数据线时可配置；留空则自动查找 ADB。
# ADB=/mnt/c/Users/<Windows用户名>/Android/platform-tools/adb.exe
# Platform Tools 37 在部分国产手机上需要旧 USB 后端。
ADB_USB_LEGACY=1
ADB_RELAY_PORT=3001

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=ime
PGPASSWORD=ime_dev_password
PGDATABASE=personal_ime

ANALYZE_CRON=*/10 * * * *
