# Copy to /home/ubuntu/shurufa-deploy/production.env and fill in secrets.
# Never commit production.env. Restrict its permissions to 600.
APP_ENV=production
NODE_ENV=production
PORT=3010
API_BASE_URL=https://my.dog8ball.com
MANAGE_BASE_URL=https://my.dog8ball.com
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=shurufa
PGDATABASE=shurufa
PGPASSWORD=
DASHBOARD_USERNAME=
# Required: unique password of at least 16 characters.
DASHBOARD_PASSWORD=
DASHBOARD_ORIGIN=https://my.dog8ball.com
# Automatically initialized once by deploy.sh after migrations; never rotate on deploy.
# Keep this key and its backup outside Git and release cleanup, with mode 600.
CALL_RECORDING_KEY_FILE=/data/phpwww/shurufa/shared/private/call-recording.key
